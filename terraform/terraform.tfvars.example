# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit PSKs.

router_public_ip = "68.48.149.112"   # or resolve mindfury.duckdns.org first
onprem_cidr      = "10.0.1.0/24"
vpc_cidr         = "10.10.0.0/16"
